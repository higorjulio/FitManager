<?xml version="1.0" encoding="utf-8"?>
<ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F2F6FC"
        android:fillViewport="true">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

        <Button
                android:id="@+id/btnVoltar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="8dp"
                android:background="@android:color/transparent"
                android:text="← Voltar"
                android:textAllCaps="false"
                android:textColor="#174B91"
                android:textSize="15sp"
                android:textStyle="bold"/>

        <!-- Cabeçalho -->
        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Meu Perfil"
                android:textColor="#174B91"
                android:textSize="28sp"
                android:textStyle="bold"/>

        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gerencie sua conta e suas informações"
                android:textColor="#68778A"
                android:textSize="14sp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="24dp"/>

        <!-- Foto de perfil -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_exercicio"
                android:padding="24dp"
                android:layout_marginBottom="18dp">

            <ImageView
                    android:id="@+id/ivFotoPerfil"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:src="@android:drawable/ic_menu_camera"
                    android:background="#E5EEF9"
                    android:padding="28dp"
                    android:scaleType="centerInside"
                    android:contentDescription="Foto de perfil"/>

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sua foto de perfil"
                    android:textColor="#174B91"
                    android:textStyle="bold"
                    android:textSize="17sp"
                    android:layout_marginTop="12dp"/>

            <Button
                    android:id="@+id/btnEscolherFoto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Adicionar foto"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#174B91"
                    android:layout_marginTop="8dp"/>

        </LinearLayout>

        <!-- Informações pessoais -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_exercicio"
                android:padding="20dp"
                android:layout_marginBottom="18dp">

            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="INFORMAÇÕES PESSOAIS"
                    android:textColor="#174B91"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_marginBottom="18dp"/>

            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nome completo"
                    android:textColor="#526579"
                    android:textSize="14sp"/>

            <EditText
                    android:id="@+id/etNomePerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Seu nome"
                    android:inputType="textPersonName"
                    android:singleLine="true"
                    android:textColor="#243B53"
                    android:layout_marginBottom="16dp"/>

            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="E-mail"
                    android:textColor="#526579"
                    android:textSize="14sp"/>

            <EditText
                    android:id="@+id/etEmailPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="seuemail@email.com"
                    android:inputType="textEmailAddress"
                    android:singleLine="true"
                    android:textColor="#243B53"
                    android:layout_marginBottom="20dp"/>

            <Button
                    android:id="@+id/btnSalvarPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Salvar alterações"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="#174B91"/>

        </LinearLayout>

        <!-- Segurança e senha -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_exercicio"
                android:padding="20dp">

            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SEGURANÇA"
                    android:textColor="#174B91"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_marginBottom="8dp"/>

            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Alterar senha"
                    android:textColor="#243B53"
                    android:textStyle="bold"
                    android:textSize="17sp"
                    android:layout_marginBottom="16dp"/>

            <EditText
                    android:id="@+id/etSenhaAtual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Senha atual"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:layout_marginBottom="12dp"/>

            <EditText
                    android:id="@+id/etNovaSenha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nova senha"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:layout_marginBottom="12dp"/>

            <EditText
                    android:id="@+id/etConfirmarNovaSenha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Confirmar nova senha"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:layout_marginBottom="20dp"/>

            <Button
                    android:id="@+id/btnAlterarSenha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Alterar senha"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="#174B91"/>

        </LinearLayout>

        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FitManager • Sua evolução começa aqui"
                android:textColor="#8291A3"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"/>

    </LinearLayout>

</ScrollView>
