<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_exercicio"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

    <TextView
            android:id="@+id/tvNomeExercicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nome do exercício"
            android:textColor="#243B53"
            android:textSize="17sp"
            android:textStyle="bold" />

    <TextView
            android:id="@+id/tvSeries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Séries: 3"
            android:textColor="#526579"
            android:textSize="14sp"
            android:layout_marginTop="9dp" />

    <TextView
            android:id="@+id/tvRepeticoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Repetições: 12"
            android:textColor="#526579"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

    <TextView
            android:id="@+id/tvDescanso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descanso: 60 segundos"
            android:textColor="#526579"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

    <CheckBox
            android:id="@+id/cbConcluido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Concluído"
            android:textColor="#174B91"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />

</LinearLayout>
